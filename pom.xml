<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mczju</groupId>
    <artifactId>ceasefire-war</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>
    <name>CeasefireWar</name>
    <description>The War of Ceasefire - 基于 MCZJUGameCore 的资源收集团队对抗小游戏</description>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 与源工程保持一致：Paper 26.2 线（原 Gradle 动态版本 26.2.build.+. 等价的最新 stable 构建）；MGC 1.1.2。 -->
        <paper.version>26.2.build.133-stable</paper.version>
        <mgc.version>1.1.2</mgc.version>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Paper API 与 MGC 均为 provided：编译期可见，运行时由服务器提供，不打包进插件。 -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.mczju-ops</groupId>
            <artifactId>MCZJUGameCore</artifactId>
            <version>${mgc.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- 过滤 plugin.yml，将 ${project.version} 替换为实际版本。 -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
